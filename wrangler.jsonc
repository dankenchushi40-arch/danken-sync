
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "danken-sync",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "MusicRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MusicRoom"]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
